# --- Service identity ---
SERVICE_NAME=retrieval-service
ENVIRONMENT=development
DEPLOYMENT_MODE=api
LOG_LEVEL=INFO

# --- gRPC server (DEPLOYMENT_MODE in {api, all}) ---
GRPC_PORT=50060
GRPC_MAX_WORKERS=10
GRPC_MAX_MESSAGE_LENGTH_BYTES=4194304
# NOTE: llm-service's RETRIEVAL_SERVICE_PORT is aligned to this default (50060).

# --- FastAPI (health/metrics — runs in every mode) ---
HTTP_PORT=8060

# --- PostgreSQL (job + inbox + outbox state, dedicated retrieval_service_db
# on the shared graphgpt-postgres container — root docker-compose.yml). Uses
# port 5433, not 5432: the same container is published on both host ports
# (root docker-compose.yml's postgres service) so this works even on a host
# where a native/local PostgreSQL install already owns 5432. If nothing else
# is on 5432 locally, localhost:5432 works identically — same container, same
# data, just a different host-side port. ---
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/retrieval_service_db
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

# --- Kafka (shared graphgpt-kafka container, DEPLOYMENT_MODE in {worker, all}) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=retrieval-service
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
KAFKA_TOPIC_FILE_UPLOADED=file.uploaded
KAFKA_TOPIC_FILE_DELETED=file.deleted
KAFKA_TOPIC_FILE_PROCESSING_RETRY=file.processing_retry
KAFKA_TOPIC_PROCESSING_STARTED=file.processing.started
KAFKA_TOPIC_PROCESSING_COMPLETED=file.processing.completed
KAFKA_TOPIC_PROCESSING_FAILED=file.processing.failed
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# --- Ingestion concurrency (worker only) ---
INGESTION_MAX_CONCURRENCY=4

# --- MinIO (read-only — reuses file-service's dedicated `file-minio`
# instance and `graphgpt-files` bucket, root docker-compose.yml; NOT the
# separate `milvus-minio` container, which is Milvus's own storage backend) ---
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_FILES=graphgpt-files
MINIO_DOWNLOAD_TIMEOUT_SECONDS=30.0

# --- embedding-service ---
EMBEDDING_SERVICE_GRPC_TARGET=localhost:50054
EMBEDDING_MODEL_EXPECTED=all-MiniLM-L6-v2
EMBEDDING_DIMENSION_EXPECTED=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_INGESTION_TIMEOUT_SECONDS=20.0
EMBEDDING_QUERY_TIMEOUT_SECONDS=0.4
EMBEDDING_RETRY_ATTEMPTS=2

# --- File Service permission-check client (HLD §16.2 — endpoint does not
# exist on File Service yet; Phase 7 builds against a local fake). REST,
# not gRPC — File Service is a FastAPI/HTTP service; port 8006 matches its
# own local-dev convention (its Makefile's `make run`). ---
FILE_SERVICE_BASE_URL=http://localhost:8006
FILE_SERVICE_PERMISSION_CHECK_TIMEOUT_SECONDS=0.3
# Service-to-service credential — secret-only, sourced from a secrets manager
# in real deployments, never committed. Placeholder for local dev only.
FILE_SERVICE_SERVICE_CREDENTIAL=dev-internal-token-change-me

# --- Milvus (shared cluster, root docker-compose.yml's milvus-standalone —
# dedicated collection, never a dedicated deployment, HLD §13) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=retrieval_document_chunks
MILVUS_SEARCH_TOP_N=40
# HNSW search breadth (sent as `ef`, never below the requested limit). Replaces the old MILVUS_SEARCH_NPROBE, which an HNSW index ignores.
MILVUS_HNSW_EF=64
MILVUS_INDEX_METRIC_TYPE=COSINE
MILVUS_CONNECT_TIMEOUT_SECONDS=5.0
# Raised from 0.5 on 2026-11-07 (see docs/retrieval-quality.md)
MILVUS_QUERY_TIMEOUT_SECONDS=1.0

# --- OpenSearch (root docker-compose.yml's opensearch service) ---
OPENSEARCH_HOSTS=localhost:9200
OPENSEARCH_INDEX_NAME=retrieval_document_chunks
OPENSEARCH_SEARCH_TOP_N=40
OPENSEARCH_QUERY_TIMEOUT_SECONDS=0.5

# --- Query pipeline tuning ---
FUSION_RRF_K=60
MMR_CANDIDATE_POOL_SIZE=40
MMR_FINAL_TOP_K=6
MMR_LAMBDA=0.7
QUERY_PIPELINE_DEADLINE_SECONDS=1.8

# --- Ingestion pipeline tuning ---
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=300

# --- Retrieval behaviour (Phase 1) ---
MMR_RELEVANCE_FLOOR=0.5
DEDUPE_JACCARD_THRESHOLD=0.9
BALANCE_ACROSS_FILES=true
HEADING_MATCH_BOOST=1.0
RETRIEVAL_MAX_TOP_K=20
OPENSEARCH_PHRASE_BOOST_ENABLED=true
OPENSEARCH_SECTION_PHRASE_BOOST=5.0
OPENSEARCH_CONTENT_PHRASE_BOOST=2.0
EMBEDDING_FAILURE_FALLBACK_BM25=true
TOKEN_COUNT_TOKENIZER_ID=sentence-transformers/all-MiniLM-L6-v2

# --- Reranker: on/off, which one, and its score thresholds ---
# The reranker model runs inside embedding-service. RERANK_MODEL must be enabled there (its RERANKER_MODEL or RERANKER_ALLOWED_MODELS).
# Measured on this repo's benchmark/CPU: ms-marco-MiniLM-L-6-v2 about 2.6 s per query, bge-reranker-v2-m3 about 35 s per query (30 passages):
# both exceed RERANK_TIMEOUT_SECONDS, in which case the query falls back to the non-reranked path. See docs/configuration.md.
RERANK_ENABLED=false
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=0.8
RERANK_TOP_N=30
RERANK_LEG_TOP_N=50
# Coverage thresholds per reranker (score scales differ by model). A reranker without an entry gives no coverage signal. Empty on purpose:
# the one set tried (ms-marco, -9 / -4.5) did not hold up on the held-out questions. Format: {"<model>": {"weak_min": x, "strong_min": y}}
RERANK_COVERAGE_THRESHOLDS={}
EXPAND_NEIGHBOURS=false
# Weak-retrieval signal (response.top_score / response.coverage). Off until you have calibrated thresholds for your reranker.
COVERAGE_ENABLED=false
COVERAGE_RANK_SIGNAL_ENABLED=false
PREVIOUS_CHUNKS_ENABLED=true
PREVIOUS_CHUNKS_MAX=10
PREVIOUS_CHUNKS_WEIGHT=1.0
DOCUMENT_CHUNKS_MAX=5000
# Logs one `retrieval.feedback` line per query; the query text is included only when this is true.
LOG_QUERY_TEXT=false

# --- Document parsing: Docling (PDF / Word / PowerPoint / Excel / HTML) ---
# DOCLING_ENABLED=false refuses those file types with a clear message and never loads Docling (text, Markdown, CSV and code still work).
# DOCLING_TABLE_STRUCTURE / DOCLING_TABLE_MODE change what is extracted: apply them with a NEW index generation.
DOCLING_ENABLED=true
DOCLING_TABLE_STRUCTURE=true
# "" = Docling's default, or fast | accurate
DOCLING_TABLE_MODE=
# auto | cpu | cuda | mps | xpu
DOCLING_DEVICE=auto
# 0 = Docling's default
DOCLING_NUM_THREADS=0
# 0 = no limit
DOCLING_DOCUMENT_TIMEOUT_SECONDS=0
DOCLING_REUSE_CONVERTER=false

# --- Chunking for index generation 2+ (tokens of the embedding model) ---
CHUNK_TARGET_TOKENS_V2=200
CHUNK_OVERLAP_TOKENS_V2=30
CHUNK_MAX_MARGIN_V2=16

# --- Index generations ---
GENERATION_REFRESH_SECONDS=30
OPENSEARCH_ACTIVE_ALIAS=retrieval_document_chunks_active

# --- Optional ingestion features (all off by default) ---
OCR_ENABLED=false
OCR_MIN_CHARS_PER_PAGE=20
OCR_MAX_PAGES_PER_DOCUMENT=50
# Master switch for contextual chunk text. It sends document text to the model below; nothing is sent unless this is true AND the index
# generation was created with `--contextual`.
CONTEXTUAL_CHUNKS_ENABLED=false
CONTEXT_MAX_TOKENS=60
CONTEXT_LLM_URL=
CONTEXT_LLM_MODEL=
CONTEXT_LLM_API_KEY=
CONTEXT_LLM_TIMEOUT_SECONDS=20.0
CONTEXT_LLM_CONCURRENCY=4

# --- Observability ---
METRICS_ENABLED=true
HEALTH_CHECK_TIMEOUT_SECONDS=3.0
