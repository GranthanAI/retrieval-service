# --- Service identity ---
SERVICE_NAME=retrieval-service
ENVIRONMENT=development
DEPLOYMENT_MODE=api
LOG_LEVEL=INFO

# --- gRPC server (DEPLOYMENT_MODE in {api, all}) ---
GRPC_PORT=50060
GRPC_MAX_WORKERS=10
GRPC_MAX_MESSAGE_LENGTH_BYTES=4194304
# NOTE: llm-service's own .env.example currently points RETRIEVAL_SERVICE_PORT
# at 50053, not this default (50060, per LLD §2). Reconcile with llm-service's
# config when wiring the real GetRelevantChunks client in Phase 9 — don't
# silently change either side without updating the other.

# --- FastAPI (health/metrics — runs in every mode) ---
HTTP_PORT=8060

# --- PostgreSQL (job + inbox + outbox state, dedicated retrieval_service_db
# on the shared graphgpt-postgres container — root docker-compose.yml). Uses
# port 5433, not 5432: the same container is published on both host ports
# (root docker-compose.yml's postgres service) so this works even on a host
# where a native/local PostgreSQL install already owns 5432. If nothing else
# is on 5432 locally, localhost:5432 works identically — same container, same
# data, just a different host-side port. ---
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/retrieval_service_db
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

# --- Kafka (shared graphgpt-kafka container, DEPLOYMENT_MODE in {worker, all}) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=retrieval-service
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
KAFKA_TOPIC_FILE_UPLOADED=file.uploaded
KAFKA_TOPIC_FILE_DELETED=file.deleted
KAFKA_TOPIC_FILE_PROCESSING_RETRY=file.processing_retry
KAFKA_TOPIC_PROCESSING_STARTED=file.processing.started
KAFKA_TOPIC_PROCESSING_COMPLETED=file.processing.completed
KAFKA_TOPIC_PROCESSING_FAILED=file.processing.failed
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# --- Ingestion concurrency (worker only) ---
INGESTION_MAX_CONCURRENCY=4

# --- MinIO (read-only — reuses file-service's dedicated `file-minio`
# instance and `graphgpt-files` bucket, root docker-compose.yml; NOT the
# separate `milvus-minio` container, which is Milvus's own storage backend) ---
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_FILES=graphgpt-files
MINIO_DOWNLOAD_TIMEOUT_SECONDS=30.0

# --- embedding-service ---
EMBEDDING_SERVICE_GRPC_TARGET=localhost:50054
EMBEDDING_MODEL_EXPECTED=all-MiniLM-L6-v2
EMBEDDING_DIMENSION_EXPECTED=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_INGESTION_TIMEOUT_SECONDS=20.0
EMBEDDING_QUERY_TIMEOUT_SECONDS=0.4
EMBEDDING_RETRY_ATTEMPTS=2

# --- File Service permission-check client (HLD §16.2 — endpoint does not
# exist on File Service yet; Phase 7 builds against a local fake) ---
FILE_SERVICE_GRPC_TARGET=localhost:50052
FILE_SERVICE_PERMISSION_CHECK_TIMEOUT_SECONDS=0.3
# Service-to-service credential — secret-only, sourced from a secrets manager
# in real deployments, never committed. Placeholder for local dev only.
FILE_SERVICE_SERVICE_CREDENTIAL=

# --- Milvus (shared cluster, root docker-compose.yml's milvus-standalone —
# dedicated collection, never a dedicated deployment, HLD §13) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=retrieval_document_chunks
MILVUS_SEARCH_TOP_N=40
MILVUS_SEARCH_NPROBE=16
MILVUS_INDEX_METRIC_TYPE=COSINE
MILVUS_CONNECT_TIMEOUT_SECONDS=5.0
MILVUS_QUERY_TIMEOUT_SECONDS=0.5

# --- OpenSearch (root docker-compose.yml's opensearch service) ---
OPENSEARCH_HOSTS=localhost:9200
OPENSEARCH_INDEX_NAME=retrieval_document_chunks
OPENSEARCH_SEARCH_TOP_N=40
OPENSEARCH_QUERY_TIMEOUT_SECONDS=0.5

# --- Query pipeline tuning ---
FUSION_RRF_K=60
MMR_CANDIDATE_POOL_SIZE=40
MMR_FINAL_TOP_K=6
MMR_LAMBDA=0.7
QUERY_PIPELINE_DEADLINE_SECONDS=1.8

# --- Ingestion pipeline tuning ---
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=300

# --- Observability ---
METRICS_ENABLED=true
HEALTH_CHECK_TIMEOUT_SECONDS=3.0
